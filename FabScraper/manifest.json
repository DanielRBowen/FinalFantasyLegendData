{
  "manifest_version": 3,
  "name": "Fab Library Exporter",
  "version": "1.0",
  "description": "Progressively scrolls and exports your Fab.com asset library to JSON.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.fab.com/*"],
      "js": ["content.js"]
    }
  ]
}